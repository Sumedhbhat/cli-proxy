{
  "name": "cli-proxy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "demo": "node src/server.ts --demo",
    "setup": "node scripts/setup.ts",
    "engine": "node scripts/engine.ts",
    "plugin:build": "node scripts/build-plugin.ts",
    "test:engine": "node --test test/ledger-engine.test.ts",
    "service:install": "node scripts/setup.ts",
    "clients:configure": "node scripts/configure-clients.ts",
    "restore-priorities": "node scripts/restore-priorities.ts",
    "export-demo": "node scripts/export-demo.ts",
    "test": "node --test test/*.test.js test/*.test.ts",
    "check": "npm run typecheck && npm run format:check && npm run migration:check && npm test",
    "build": "node scripts/build.ts",
    "prestart": "node scripts/ensure-built.ts",
    "predemo": "node scripts/ensure-built.ts",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "migration:check": "node scripts/check-migration.ts",
    "preclients:configure": "node scripts/ensure-built.ts",
    "format": "prettier --write src scripts public/*.ts test tsconfig.json package.json",
    "format:check": "prettier --check src scripts public/*.ts test tsconfig.json package.json",
    "prepare": "npm run build",
    "recovery:install": "npm run build && node scripts/install-recovery.ts",
    "service:status": "node dist/maintenance.cjs status",
    "service:rollback": "node dist/maintenance.cjs rollback"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.6",
    "@effect/platform-node-shared": "4.0.6",
    "effect": "4.0.6"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
